{
  "name": "linkpocket-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "job:cleanup-unverified": "node dist/jobs/cli.js cleanup-unverified",
    "job:dev": "tsx src/jobs/cli.ts",
    "smoke:dist": "node --input-type=module -e \"await import('./dist/app.js'); await import('./dist/db/migrations/index.js'); await import('./dist/jobs/cleanup-unverified.js'); await import('./dist/admin/bootstrap.js'); console.log('dist modules load')\"",
    "e2e:server": "tsx scripts/e2e-server.ts",
    "admin:bootstrap": "node dist/admin/bootstrap-cli.js",
    "admin:bootstrap:dev": "tsx src/admin/bootstrap-cli.ts",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject dist && sentry-cli sourcemaps upload dist",
    "load:seed": "tsx scripts/load-seed.ts",
    "migrate:dist": "node dist/db/migrate-cli.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@sentry/node": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "^3.8.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "description": "LinkPocket API (Express, MongoDB)",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  }
}
